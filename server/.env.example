# Server Port (default 5000)
PORT=5000

# Environment ('development' | 'production')
NODE_ENV=production

# Client origin for CORS (comma-separated if multiple, e.g. https://yourdomain.com)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# NewsData.io API Key (https://newsdata.io)
NEWS_DATA_API_KEY=your_newsdata_api_key_here
